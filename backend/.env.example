# 🌐 Server Configuration
PORT=5000

# 🗄️ Database Connection
MONGO_URI=your_mongodb_connection_uri

# 🔐 JWT Configuration
JWT_SECRET=your_jwt_signing_secret

# 📧 Email & API Services
